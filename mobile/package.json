{
    "name": "poskasir-mobile",
    "version": "1.0.0",
    "private": true,
    "description": "Pembungkus Android (Capacitor) untuk POS Kasir — menambahkan cetak struk ke printer termal Bluetooth.",
    "scripts": {
        "sync": "cap sync android",
        "open": "cap open android",
        "build:debug": "cd android && ./gradlew assembleDebug",
        "build:release": "cd android && ./gradlew assembleRelease"
    },
    "dependencies": {
        "@capacitor/android": "^7.0.0",
        "@capacitor/core": "^7.0.0",
        "capacitor-thermal-printer": "^0.2.5"
    },
    "devDependencies": {
        "@capacitor/cli": "^7.0.0"
    }
}
